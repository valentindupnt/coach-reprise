{
  "name": "coach-reprise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test:db": "node tests/db.test.mjs",
    "test:e2e": "VITE_SUPABASE_URL=http://localhost:54321 VITE_SUPABASE_KEY=anon-test-key vite build --outDir dist && node tests/e2e.mjs",
    "content": "node scripts/build-content.mjs && python3 scripts/build-relecture.py",
    "test:content": "node tests/content.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
